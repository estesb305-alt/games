{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 14" }
          }
        },
        "actions": {
          "$id": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}
